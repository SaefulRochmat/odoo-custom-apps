<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_helpdesk_ticket_tree" model="ir.ui.view">
        <field name="name">helpdesk.ticket.list</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <list string="Tickets" decoration-warning="priority == '1'" decoration-danger="priority == '3'">
                <field name="name"/>
                <field name="title"/>
                <field name="partner_id"/>
                <field name="category_id"/>
                <field name="stage_id"/>
                <field name="priority" widget="priority"/>
                <field name="user_id"/>
                <field name="sla_deadline"/>
                <field name="sla_reached"/>
            </list>
        </field>
    </record>

    <record id="view_helpdesk_ticket_search" model="ir.ui.view">
        <field name="name">helpdesk.ticket.search</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="title"/>
                <field name="partner_id"/>
                <field name="category_id"/>
                <field name="user_id"/>
                <field name="stage_id"/>
                <filter name="my_tickets" string="My Tickets" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="unassigned" string="Unassigned" domain="[('user_id', '=', False)]"/>
                <group>
                    <filter name="group_stage" string="Stage" context="{'group_by': 'stage_id'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_user" string="Assigned Technician" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_helpdesk_ticket_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <form string="Helpdesk Ticket">
                <header>
                    <button name="action_assign_to_me" type="object" string="Assign to Me" class="btn-primary"/>
                    <button name="%(action_ticket_reassign_wizard)d" type="action" string="Reassign Ticket" class="btn-secondary"/>
                    <button name="action_send_csat_survey" type="object" string="Send CSAT Survey" class="btn-secondary"/>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="title"/>
                            <field name="partner_id"/>
                            <field name="category_id"/>
                            <field name="equipment_id"/>
                        </group>
                        <group>
                            <field name="priority" widget="priority"/>
                            <field name="user_id"/>
                            <field name="team_leader_id"/>
                            <field name="sla_deadline"/>
                            <field name="sla_reached"/>
                            <field name="sla_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" widget="html"/>
                        </page>
                        <page string="Timesheets">
                            <field name="timesheet_ids" context="{'default_ticket_id': active_id}"/>
                        </page>
                        <page string="Customer Feedback">
                            <group>
                                <field name="csat_rating"/>
                                <field name="close_date"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_helpdesk_ticket_kanban" model="ir.ui.view">
        <field name="name">helpdesk.ticket.kanban</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column" quick_create="false">
                <field name="name"/>
                <field name="title"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="priority"/>
                <field name="stage_id"/>
                <field name="sla_deadline"/>
                <field name="sla_reached"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <div><field name="title"/></div>
                                </div>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><span>Requester: </span><field name="partner_id"/></div>
                                <div><span>Assigned: </span><field name="user_id"/></div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span class="badge badge-warning" t-if="record.sla_reached.raw_value == false and record.sla_deadline.raw_value">
                                        SLA Due
                                    </span>
                                    <span class="badge badge-success" t-if="record.sla_reached.raw_value == true">
                                        SLA OK
                                    </span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_helpdesk_ticket_pivot" model="ir.ui.view">
        <field name="name">helpdesk.ticket.pivot</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <pivot string="Ticket Analysis">
                <field name="category_id" type="row"/>
                <field name="user_id" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_helpdesk_ticket_graph" model="ir.ui.view">
        <field name="name">helpdesk.ticket.graph</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <graph string="Ticket Volume">
                <field name="category_id"/>
                <field name="user_id"/>
            </graph>
        </field>
    </record>

    <record id="action_helpdesk_ticket" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">kanban,list,form,pivot,graph</field>
        <field name="context">{'search_default_my_tickets': 1}</field>
    </record>
</odoo>
