<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_helpdesk" model="ir.module.category">
        <field name="name">IT Helpdesk</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_helpdesk_user" model="res.groups">
        <field name="name">Helpdesk User</field>
        <field name="category_id" ref="module_category_helpdesk"/>
        <field name="comment">User can submit and view their own tickets.</field>
    </record>

    <record id="group_helpdesk_technician" model="res.groups">
        <field name="name">Helpdesk Technician</field>
        <field name="category_id" ref="module_category_helpdesk"/>
        <field name="implied_ids" eval="[(4, ref('group_helpdesk_user'))]"/>
        <field name="comment">Technician can work assigned tickets, change stages, and log time.</field>
    </record>

    <record id="group_helpdesk_manager" model="res.groups">
        <field name="name">Helpdesk Manager</field>
        <field name="category_id" ref="module_category_helpdesk"/>
        <field name="implied_ids" eval="[(4, ref('group_helpdesk_technician'))]"/>
        <field name="comment">Manager has full access to configurations and service performance.</field>
    </record>

    <record id="group_helpdesk_user_rule_user" model="ir.rule">
        <field name="name">Helpdesk User: own tickets</field>
        <field name="model_id" ref="model_helpdesk_ticket"/>
        <field name="groups" eval="[(4, ref('group_helpdesk_user'))]"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="group_helpdesk_technician_rule_assigned" model="ir.rule">
        <field name="name">Helpdesk Technician: all tickets and assigned</field>
        <field name="model_id" ref="model_helpdesk_ticket"/>
        <field name="groups" eval="[(4, ref('group_helpdesk_technician'))]"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="group_helpdesk_manager_rule_all" model="ir.rule">
        <field name="name">Helpdesk Manager: all tickets</field>
        <field name="model_id" ref="model_helpdesk_ticket"/>
        <field name="groups" eval="[(4, ref('group_helpdesk_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
