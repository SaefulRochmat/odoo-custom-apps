<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ticket_reassign_wizard_form" model="ir.ui.view">
        <field name="name">ticket.reassign.wizard.form</field>
        <field name="model">ticket.reassign.wizard</field>
        <field name="arch" type="xml">
            <form string="Reassign Ticket">
                <group>
                    <field name="technician_id"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button string="Confirm Reassignment" name="action_reassign" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ticket_reassign_wizard" model="ir.actions.act_window">
        <field name="name">Reassign Tickets</field>
        <field name="res_model">ticket.reassign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
